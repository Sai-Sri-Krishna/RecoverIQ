# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Required for AI-powered root cause analysis and the conversational assistant.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Application URL ──────────────────────────────────────────────────────────
# The public URL where this app is hosted (used for Razorpay callback URLs).
# Example: https://recoveriq.example.com
# Leave empty for local development (defaults to http://localhost:3000)
APP_URL=

# ─── Razorpay Test Mode ───────────────────────────────────────────────────────
# IMPORTANT: Only TEST mode keys (rzp_test_...) are accepted.
# Live mode keys are rejected by the application's safety guard.
# Get your test keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: Razorpay webhook signing secret for signature verification.
# Configure this in your Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
